{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Owl-L",
  "version": "../package.json",
  "identifier": "lab.seconddawn.owll",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Owl-L",
        "width": 1040,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true
      },
      {
        "label": "quick",
        "title": "Owl-L quick translation",
        "width": 420,
        "height": 260,
        "minWidth": 320,
        "minHeight": 180,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Second Dawn",
    "copyright": "Second Dawn contributors",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "shortDescription": "Owl-L: offline, private translator",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer/hooks.nsh",
        "languages": [
          "English",
          "German"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyRjhFMTU1NTIwODEwOTUKUldTVkVBaFNWZUg0NHF4SjQ5bm1tT0tpSVQzZ3NZR3VFMUMwMkozU3YrYW9kZ2o0TGtocXdnTWQK",
      "endpoints": [
        "https://github.com/Second-Dawn-Lab/owll/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
