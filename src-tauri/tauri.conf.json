{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Owl-L",
  "version": "0.0.0",
  "identifier": "lab.seconddawn.owll",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Owl-L",
        "width": 1040,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      },
      {
        "label": "quick",
        "title": "Owl-L quick translation",
        "width": 420,
        "height": 260,
        "minWidth": 320,
        "minHeight": 180,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Second Dawn",
    "copyright": "Second Dawn contributors",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
